; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Harmonies-Cascadia"
config/version="0.1.0"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="uid://dvpyk6otk5nkh"
config/windows_native_icon="res://assets/ui/symbia_favicon.ico"

[autoload]

GameSession="*res://scripts/game/game_session.gd"
GameSettings="*res://scripts/game/game_settings.gd"
SupabaseClient="*res://scripts/net/supabase_client.gd"
CardCatalog="*uid://b8oog78vthmvf"
Enums="*uid://dx4s0agjfg2qs"
ElementCatalog="*uid://d2wigwbdsvfso"
TileSetupCatalog="*res://scripts/data/tile_setup_catalog.gd"
BoosterCatalog="*uid://crtpprdxd6gj4"
RuleCatalog="*uid://tqkcwruu08es"
QuestCatalog="*uid://dwsmx6x25woub"
GameFeedback="*res://scenes/effects/game_feedback.tscn"
SceneLoader="*res://scenes/game/scene_loader.tscn"
UiPointerBlock="*res://scripts/input/ui_pointer_block.gd"
InputScheme="*res://scripts/input/input_scheme.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=0

[global_group]

interactable=""

